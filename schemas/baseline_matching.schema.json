{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BaselineMatchingOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "matches"],
  "properties": {
    "document_id": { "type": "string" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intervention_scenario_temp_id",
          "baseline_scenario_temp_id",
          "comparison_logic",
          "match_confidence",
          "status"
        ],
        "properties": {
          "intervention_scenario_temp_id": { "type": "string" },
          "baseline_scenario_temp_id": {
            "type": ["string", "null"],
            "description": "Null if no valid baseline exists."
          },
          "comparison_logic": {
            "type": ["string", "null"],
            "enum": [
              "same_building_no_intervention",
              "same_year_same_climate",
              "pre_post",
              "factorial_reference",
              "not_applicable",
              "unclear",
              null
            ]
          },
          "match_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "evidence_page": { "type": ["integer", "null"] },
          "evidence_text": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["matched", "no_valid_baseline", "unclear"]
          }
        }
      }
    }
  }
}
